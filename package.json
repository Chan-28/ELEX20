{
  "name": "elex20",
  "version": "1.2.0",
  "description": "Monitoramento de sons urbanos com ESP32-S3, Edge Impulse, MQTT, n8n, TimescaleDB e Grafana.",
  "main": "commitlint.config.cjs",
  "type": "commonjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "uv run ruff check .",
    "lint:branch": "sh scripts/lint-branch-name.sh",
    "format": "uv run ruff format .",
    "fix": "uv run ruff check . --fix && uv run ruff format ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chan-28/ELEX20.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Chan-28/ELEX20/issues"
  },
  "homepage": "https://github.com/Chan-28/ELEX20#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
