# Normaliza line endings para LF em todos os arquivos de texto
* text=auto eol=lf

# Arquivos específicos do Windows usam CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binários — sem conversão
*.dll filter=lfs diff=lfs merge=lfs -text
*.bin -text
*.exe -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.zip -text

# Firmware / PlatformIO
*.elf -text
*.hex -text

# Evita diff de arquivos gerados
uv.lock linguist-generated=true
package-lock.json linguist-generated=true
