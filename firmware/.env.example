# Variáveis de ambiente do firmware ESP32
# Copie para firmware/.env e preencha com os valores reais.
# Estas variáveis são injetadas como build_flags pelo firmware/load_env.py
# (o ambiente do shell tem prioridade sobre este arquivo).

# Credenciais WiFi
WIFI_SSID=
WIFI_PASS=

# IP do servidor onde o Mosquitto está rodando (docker-compose)
# Em Linux: ip route get 1 | awk '{print $7}' para obter o IP do host
MQTT_HOST=192.168.1.100

# Credenciais MQTT do usuário "device". A senha é gerada pela stack; para vê-la:
#   docker compose exec mosquitto cat /run/secrets/mqtt_device/value
MQTT_USER=device
MQTT_PASS=

# Pinos I2S do microfone (padrão: INMP441 no ESP32-S3-DevKitC-1)
# I2S_WS_PIN=42
# I2S_SCK_PIN=40
# I2S_SD_PIN=41
