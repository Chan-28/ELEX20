# Variáveis de ambiente do firmware ESP32
# Copie para firmware/.env e preencha com os valores reais.
# Estas variáveis são injetadas como build_flags pelo firmware/load_env.py
# (o ambiente do shell tem prioridade sobre este arquivo).

# Credenciais WiFi (só 2,4 GHz)
WIFI_SSID=
WIFI_PASS=

# Wi-Fi institucional (WPA2-Enterprise, como o eduroam): preencha WIFI_EAP_USER.
# WIFI_PASS vira a senha desse usuário. Deixe em branco numa rede doméstica.
#   WIFI_EAP_USER      usuário completo, ex.: aluno@universidade.br
#   WIFI_EAP_IDENTITY  identidade externa (opcional), ex.: anonymous@universidade.br
#   WIFI_EAP_METHOD    PEAP (padrão) ou TTLS; a TI da instituição informa
#   WIFI_EAP_CA_FILE   certificado da CA do servidor da rede, em PEM, relativo a firmware/.
#                      Recomendado: sem ele, um ponto de acesso falso pode capturar a senha.
WIFI_EAP_USER=
WIFI_EAP_IDENTITY=
WIFI_EAP_METHOD=
WIFI_EAP_CA_FILE=

# IP do servidor onde o Mosquitto está rodando (docker-compose)
# Em Linux: ip route get 1 | awk '{print $7}' para obter o IP do host
MQTT_HOST=192.168.1.100

# Credenciais MQTT do usuário "device". A senha é gerada pela stack; para vê-la:
#   docker compose exec mosquitto cat /run/secrets/mqtt_device/value
MQTT_USER=device
MQTT_PASS=
