# Variáveis de ambiente do firmware ESP32
# Copie para firmware/.env e preencha com os valores reais.
# Estas variáveis são injetadas como build_flags pelo platformio.ini
# via ${sysenv.NOME_DA_VAR}.

# Credenciais WiFi
WIFI_SSID=
WIFI_PASS=

# IP do servidor onde o Mosquitto está rodando (docker-compose)
# Em Linux: ip route get 1 | awk '{print $7}' para obter o IP do host
MQTT_HOST=192.168.1.100
