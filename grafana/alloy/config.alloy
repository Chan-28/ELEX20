loki.write "loki_receiver" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

local.file_match "docker_logs" {
  path_targets = [{
    __path__ = "/var/lib/docker/containers/*/*.log",
    job      = "containerlogs",
  }]
}

loki.source.file "docker_scraper" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.clean_docker_json.receiver]
}

loki.process "clean_docker_json" {
  stage.json {
    expressions = { "output" = "log", "stream" = "stream" }
  }

  stage.labels {
    values = { "stream" = "stream" }
  }

  stage.output {
    source = "output"
  }

  // Redação de segredos antes de enviar ao Loki (as consultas do Grafana leem tudo).
  // Só o grupo de captura é trocado. Cobre "chave=valor"/"chave: valor" e formatos de token conhecidos.
  stage.replace {
    expression = "(?i)(?:token|secret|passw(?:or)?d|pass|api[_-]?key|authorization)[\"']?\\s*[:=]\\s*[\"']?(?:bearer\\s+)?([^\\s\"',;&]+)"
    replace    = "<redacted>"
  }

  stage.replace {
    expression = "\\b(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|[0-9]{8,10}:[A-Za-z0-9_-]{30,}|eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})\\b"
    replace    = "<redacted>"
  }

  forward_to = [loki.write.loki_receiver.receiver]
}