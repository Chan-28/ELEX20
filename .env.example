# ============================================================
# Template de variáveis de ambiente — copie para .env
# NUNCA commite o .env (contém credenciais reais).
# ============================================================

# ── Compose ─────────────────────────────────────────────────
# "logs" liga o Alloy (coleta de logs dos containers), que só funciona em Linux/WSL2.
# No macOS e no Windows (Docker Desktop) deixe vazio: COMPOSE_PROFILES=
COMPOSE_PROFILES=logs

# ── Grafana (http://localhost:3000) ─────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# ── TimescaleDB / PostgreSQL (interno, sem porta exposta) ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=grafana

# ── MQTT (Mosquitto) ────────────────────────────────────────
# Usuários: "device" (ESP32, publica) e "n8n" (assina). As senhas são geradas sozinhas.
# IP do host onde a porta 1883 é publicada. Padrão: só loopback.
# Para o ESP32 na LAN, use o IP do host nessa rede (nunca 0.0.0.0).
MQTT_BIND=127.0.0.1

# ── N8N (http://localhost:5678) ─────────────────────────────
# As credenciais de login são criadas pelo wizard na 1ª abertura
# e ficam salvas no volume n8n_data. Não há env var para pré-configurar.
N8N_DB=n8n
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Segredos internos (gerados automaticamente) ────────────
# Senhas dos papéis do banco (GRAFANA_RO_PASSWORD, N8N_DB_PASSWORD, HERMES_RO_PASSWORD), do MQTT
# (MQTT_DEVICE_PASS, MQTT_N8N_PASS) e dos tokens n8n ↔ Hermes (HERMES_WEBHOOK_SECRET,
# N8N_COMMAND_TOKEN) NÃO precisam ser definidas: o serviço secrets-init gera cada uma na primeira
# subida e as guarda em volumes do Docker. Defina uma aqui só se quiser fixar o valor.
# Para ver a senha do sensor (MQTT_PASS do firmware):
#   docker compose exec mosquitto cat /run/secrets/mqtt_device/value

# ── Hermes Dashboard (http://localhost:9119) ────────────────
# Placeholders de login: troque antes de qualquer uso fora da sua máquina.
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASS=password

# ── Gateways de mensagens ───────────────────────────────────
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Allowlists do Hermes (IDs separados por vírgula). Vazio = ninguém é autorizado.
TELEGRAM_ALLOWED_USERS=
DISCORD_ALLOWED_USERS=
# Chat que recebe os alertas do n8n (ID do chat/canal)
TELEGRAM_HOME_CHANNEL=
DISCORD_HOME_CHANNEL=

# ── E-mail (SMTP / IMAP para o Hermes) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
