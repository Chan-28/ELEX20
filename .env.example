# ============================================================
# Template de variáveis de ambiente — copie para .env
# NUNCA commite o .env (contém credenciais reais).
# ============================================================

# ── Grafana (http://localhost:3000) ─────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# ── TimescaleDB / PostgreSQL (interno, sem porta exposta) ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=grafana

# ── N8N (http://localhost:5678) ─────────────────────────────
# As credenciais de login são criadas pelo wizard na 1ª abertura
# e ficam salvas no volume n8n_data. Não há env var para pré-configurar.
N8N_DB=n8n
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Portainer (http://localhost:9000) ───────────────────────
# Senha definida em portainer/admin_password_hash (hash bcrypt do arquivo no repositório).
# Padrão: admin / password
# Para trocar a senha:
#   1. Gere novo hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'NOVA_SENHA', bcrypt.gensalt()).decode())" > portainer/admin_password_hash
#   2. Recrie o container:  docker compose down && docker volume rm elex20_portainer_data && docker compose up -d portainer

# ── Hermes Dashboard (http://localhost:9119) ────────────────
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASS=password

# ── Gateways de mensagens ───────────────────────────────────
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# ── E-mail (SMTP / IMAP para o Hermes) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
