# ============================================================
# Template de variáveis de ambiente — copie para .env
# NUNCA commite o .env (contém credenciais reais).
# ============================================================

# ── Grafana (http://localhost:3000) ─────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# ── TimescaleDB / PostgreSQL (interno, sem porta exposta) ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=grafana

# ── N8N (http://localhost:5678) ─────────────────────────────
# As credenciais de login são criadas pelo wizard na 1ª abertura
# e ficam salvas no volume n8n_data. Não há env var para pré-configurar.
N8N_DB=n8n
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Hermes Dashboard (http://localhost:9119) ────────────────
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASS=password

# ── Gateways de mensagens ───────────────────────────────────
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# ── E-mail (SMTP / IMAP para o Hermes) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com

# ── Docker socket (opcional — apenas se o backend de terminal do Hermes for usado) ──
# Linux / macOS: valor padrão já configurado, não precisa definir.
# Windows (Docker Desktop + WSL2): o valor padrão também funciona.
# Se precisar sobrescrever:
# DOCKER_HOST=unix:///var/run/docker.sock
