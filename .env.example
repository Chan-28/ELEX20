# ============================================================
# Template de variáveis de ambiente — copie para .env
# NUNCA commite o .env (contém credenciais reais).
# ============================================================

# ── Compose ─────────────────────────────────────────────────
# "logs" liga o Alloy (coleta de logs dos containers), que só funciona em Linux/WSL2.
# No macOS e no Windows (Docker Desktop) deixe vazio: COMPOSE_PROFILES=
COMPOSE_PROFILES=logs

# ── Grafana (http://localhost:3000) ─────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# ── TimescaleDB / PostgreSQL (interno, sem porta exposta) ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=grafana

# ── Papéis do banco (criados por timescaledb/db-init.sql a cada `up`) ──
# Sem valor padrão de propósito: gere cada uma com `openssl rand -hex 24`.
GRAFANA_RO_PASSWORD=
N8N_DB_PASSWORD=
HERMES_RO_PASSWORD=

# ── MQTT (Mosquitto) ────────────────────────────────────────
# Usuários: "device" (ESP32, publica) e "n8n" (assina). Gere com `openssl rand -hex 24`.
MQTT_DEVICE_PASS=
MQTT_N8N_PASS=
# IP do host onde a porta 1883 é publicada. Padrão: só loopback.
# Para o ESP32 na LAN, use o IP do host nessa rede (nunca 0.0.0.0).
MQTT_BIND=127.0.0.1

# ── N8N (http://localhost:5678) ─────────────────────────────
# As credenciais de login são criadas pelo wizard na 1ª abertura
# e ficam salvas no volume n8n_data. Não há env var para pré-configurar.
N8N_DB=n8n
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Ponte n8n ↔ Hermes ──────────────────────────────────────
# Sem valor padrão de propósito: gere cada uma com `openssl rand -hex 24`.
# HERMES_WEBHOOK_SECRET assina os alertas do n8n para o Hermes (HMAC).
# N8N_COMMAND_TOKEN autentica o Hermes ao pedir um comando ao sensor pelo n8n.
HERMES_WEBHOOK_SECRET=
N8N_COMMAND_TOKEN=

# ── Hermes Dashboard (http://localhost:9119) ────────────────
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASS=password

# ── Gateways de mensagens ───────────────────────────────────
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Allowlists do Hermes (IDs separados por vírgula). Vazio = ninguém é autorizado.
TELEGRAM_ALLOWED_USERS=
DISCORD_ALLOWED_USERS=
# Chat que recebe os alertas do n8n (ID do chat/canal)
TELEGRAM_HOME_CHANNEL=
DISCORD_HOME_CHANNEL=

# ── E-mail (SMTP / IMAP para o Hermes) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
