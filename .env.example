# ============================================================
# Template de variáveis de ambiente — copie para .env
# e preencha com valores reais (NUNCA commite o .env).
# ============================================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TROQUE_PARA_SENHA_FORTE

# TimeScaleDB / PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_PARA_SENHA_FORTE
POSTGRES_DB=grafana

# Hermes Agent
HERMES_BASIC_AUTH_PASS=TROQUE_PARA_SENHA_FORTE

# Gateways — obtenha os tokens nos respectivos portais
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# E-mail (SMTP / IMAP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com

# N8N — URL acessível externamente para webhooks
N8N_WEBHOOK_URL=http://localhost:5678/

# ESP32 / MQTT (referência — as variáveis reais ficam em firmware/.env)
# WIFI_SSID=
# WIFI_PASS=
# MQTT_HOST=192.168.x.x  # IP do host onde o Mosquitto está rodando
